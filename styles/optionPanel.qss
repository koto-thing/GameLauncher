/* optionPanel.qss */

/* パネル全体 */
#OptionPanel {
    background-color: #1e1e1e;
    border: none;
    border-radius: 12px;
}

/* 左側のリストデザイン */
QListWidget {
    background-color: #171717;
    border: none;
    outline: 0;
    padding: 10px 0px;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

QListWidget::item {
    background-color: transparent;
    color: #999999;
    height: 38px;
    padding-left: 20px;
    margin: 0px;
    font-family: "Yu Gothic UI", "Meiryo", sans-serif;
    font-size: 13px;
    font-weight: normal;
    border: none;
}

QListWidget::item:hover {
    background-color: #252525;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #2d2d2d;
    color: #ffffff;
    border-left: 3px solid #ffffff;
    padding-left: 17px;
}

QListWidget::item:selected:active {
    outline: none;
}

/* グループごとの見出し */
.SectionHeader {
    color: #888888;
    font-size: 11px;
    font-weight: normal;
    margin-top: 20px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* 設定項目を囲むボックス */
.SettingsGroup {
    background-color: #2a2a2a;
    border-radius: 6px;
    padding: 0px;
}

/* グループ内の区切り線 */
.SeparatorLine {
    background-color: #3a3a3a;
    min-height: 1px;
    max-height: 1px;
    margin: 0px 15px;
}

/* オススメタグ */
.RecommendTag {
    background-color: #3a3a3a;
    color: #999999;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: normal;
    margin-left: 8px;
}

/* コンボボックス */
QComboBox {
    background-color: transparent;
    color: #ffffff;
    border: none;
    font-size: 13px;
    padding: 5px 20px 5px 5px;
    min-width: 100px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #888;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    selection-background-color: #3a3a3a;
}

/* ラジオボタン */
QRadioButton {
    color: #ffffff;
    spacing: 10px;
    font-size: 13px;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #666666;
    background: transparent;
}

QRadioButton::indicator:hover {
    border-color: #888888;
}

QRadioButton::indicator:checked {
    background-color: #ffe04d;
    border: 5px solid #2a2a2a;
    outline: 2px solid #ffe04d;
}

/* トグルスイッチ */
QCheckBox.ToggleSwitch {
    spacing: 0px;
}

QCheckBox.ToggleSwitch::indicator {
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background-color: #4a4a4a;
    border: none;
}

QCheckBox.ToggleSwitch::indicator:checked {
    background-color: #ffe04d;
}

QCheckBox.ToggleSwitch::indicator:hover {
    background-color: #5a5a5a;
}

QCheckBox.ToggleSwitch::indicator:checked:hover {
    background-color: #ffed70;
}

/* 通常のラベル */
QLabel {
    color: #ffffff;
    font-family: "Yu Gothic UI", "Meiryo", sans-serif;
    font-size: 13px;
    background-color: transparent;
}

/* 通常のチェックボックス */
QCheckBox {
    color: #ffffff;
    font-family: "Yu Gothic UI", "Meiryo", sans-serif;
    font-size: 13px;
    spacing: 8px;
    background-color: transparent;
}

/* スクロールバー */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3a;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a4a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
