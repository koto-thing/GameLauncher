{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandd.org/packages/contracts/v1/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "games"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gameId", "name", "summary", "heroUrl", "heroFocalPoint", "thumbnailUrl", "latestReleaseUrl"],
        "properties": {
          "gameId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "heroUrl": { "type": "string", "format": "uri", "pattern": "^(?:https://|http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/)" },
          "heroFocalPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "thumbnailUrl": { "type": "string", "format": "uri", "pattern": "^(?:https://|http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/)" },
          "latestReleaseUrl": { "type": "string", "format": "uri", "pattern": "^(?:https://|http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/)" }
        }
      }
    }
  }
}
