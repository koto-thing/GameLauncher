{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandd.org/packages/contracts/v1/game-release.schema.json",
  "title": "PandD game release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "version", "platform", "arch", "minimumLauncherVersion", "engine", "entrypoint", "workingDirectory", "arguments", "saveDirectoryName", "totalSize", "files", "publishedAt", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
    "version": { "$ref": "#/$defs/version" },
    "platform": { "enum": ["windows", "macos", "linux"] },
    "arch": { "enum": ["x86_64", "arm64"] },
    "minimumLauncherVersion": { "$ref": "#/$defs/version" },
    "engine": { "enum": ["unity", "godot", "siv3d"] },
    "entrypoint": { "$ref": "#/$defs/relativePath" },
    "workingDirectory": { "$ref": "#/$defs/relativePath" },
    "arguments": { "type": "array", "maxItems": 0 },
    "saveDirectoryName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$" },
    "totalSize": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 100 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "executable", "chunks"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "executable": { "type": "boolean" },
          "chunks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "size", "sha256", "url"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "size": { "type": "integer", "minimum": 1, "maximum": 268435456 },
                "sha256": { "$ref": "#/$defs/sha256" },
                "url": { "type": "string", "format": "uri", "pattern": "^(?:https://|http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/)" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
