{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandd.example/schemas/deployment-artifact-descriptor.schema.json",
  "title": "PandD deployment artifact descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactFile",
    "gameId",
    "version",
    "platform",
    "arch",
    "sizeBytes",
    "fileCount",
    "sha256",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifactFile": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.zip$",
      "maxLength": 180
    },
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "platform": { "const": "windows" },
    "arch": { "const": "x86_64" },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
    "fileCount": { "type": "integer", "minimum": 1, "maximum": 50000 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
