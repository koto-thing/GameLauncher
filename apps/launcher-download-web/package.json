{
  "name": "pandd-launcher-download-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "vite build --base=/launcher/ && node tests/e2e-runner.ts",
    "browsers:install": "playwright install chromium firefox webkit",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:inspect": "node scripts/deploy-ftps.mjs",
    "deploy:ftps": "npm run check && node scripts/deploy-ftps.mjs --upload"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.0",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
