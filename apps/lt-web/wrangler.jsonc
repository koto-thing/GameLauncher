{
  "name": "pandd-lt",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/lt/*"],
  },
  "services": [{ "binding": "LT_PUBLIC", "service": "pandd-lt-api" }],
  "observability": { "enabled": true },
}
