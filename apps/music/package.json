{
  "name": "pandd-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "node scripts/local.mjs",
    "dev:oauth": "vite --host 127.0.0.1 --port 5173",
    "db:local": "wrangler d1 migrations apply MUSIC_DB --local",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs test",
    "build": "vite build && node scripts/check-build.mjs",
    "types": "wrangler types",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "browsers:install": "node scripts/e2e.mjs install chromium firefox webkit"
  },
  "dependencies": {
    "file-type": "22.0.2",
    "hono": "4.13.7",
    "image-dimensions": "2.5.1",
    "music-metadata": "11.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "miniflare": "5.20260903.0-alpha",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  }
}
