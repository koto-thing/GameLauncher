{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pandd-music",
  "main": "src/composition/server.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "SITE_ORIGIN": "http://127.0.0.1:5173",
    "ENVIRONMENT": "local",
    "CONTACT_URL": "",
  },
  "d1_databases": [
    {
      "binding": "MUSIC_DB",
      "database_name": "pandd-music-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MUSIC_ASSETS", "bucket_name": "pandd-music-local" },
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "head_sampling_rate": 0.1,
  },
  "env": {
    "staging": {
      "name": "pandd-music-staging",
      "workers_dev": true,
      "vars": {
        "SITE_ORIGIN": "https://configure-staging.invalid",
        "ENVIRONMENT": "staging",
        "CONTACT_URL": "",
      },
      "d1_databases": [
        {
          "binding": "MUSIC_DB",
          "database_name": "pandd-music-staging",
          "database_id": "SET_STAGING_D1_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MUSIC_ASSETS", "bucket_name": "pandd-music-staging" },
      ],
    },
    "production": {
      "name": "pandd-music",
      "workers_dev": true,
      "vars": {
        "SITE_ORIGIN": "https://configure-production.invalid",
        "ENVIRONMENT": "production",
        "CONTACT_URL": "",
      },
      "d1_databases": [
        {
          "binding": "MUSIC_DB",
          "database_name": "pandd-music",
          "database_id": "SET_PRODUCTION_D1_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MUSIC_ASSETS", "bucket_name": "pandd-music" },
      ],
    },
  },
}
