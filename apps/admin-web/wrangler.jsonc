{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pandd-deployment-control-plane",
  "account_id": "1c34406f20cb851b272ae8d8a6d33780",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "vars": {
    "LOCAL_DEV_AUTH": "false",
    "GITHUB_CALLBACK_URL": "https://pandd-deployment-control-plane.gotoukenta62.workers.dev/api/auth/github/callback",
    "MUSIC_ENABLED": "true",
    "MUSIC_ENVIRONMENT": "production",
    "MUSIC_PUBLIC_URL": "https://pandd-music.koto-thing.com/",
    "MUSIC_BRIDGE_URL": "https://pandd-music.koto-thing.com/bridge.php",
    "MUSIC_BRIDGE_KEY_ID": "primary",
    "STAGING_DISPATCH_ENABLED": "true",
    "PRODUCTION_DISPATCH_ENABLED": "true",
    "GITHUB_CLIENT_ID": "Iv23linf562liNP3UAZQ",
    "GITHUB_APP_ID": "4572777",
    "GITHUB_APP_INSTALLATION_ID": "153252357",
    "GITHUB_REPOSITORY_ID": "1152962221"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pandd-deployment-control-plane",
      "database_id": "4441edb6-423b-4e48-8db9-c61967410b78",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INTAKE",
      "bucket_name": "pandd-launcher-intake"
    }
  ],
  "observability": {
    "enabled": true
  }
}
