{
  "name": "pandd-deployment-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "schema:generate": "node scripts/generate-validators.js",
    "predev": "npm run rust:build && npm run schema:generate",
    "prebuild": "npm run rust:build && npm run schema:generate && npm run music:build",
    "dev": "vinext dev",
    "build": "vinext build",
    "predeploy:cloudflare": "npm run prebuild",
    "deploy:cloudflare": "vinext-cloudflare deploy",
    "start": "vinext start",
    "test": "npm run build && node --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern lib/generated && oxlint",
    "db:generate": "drizzle-kit generate",
    "music:build": "npm --prefix ../music run build:manager",
    "rust:build": "node scripts/build-intake-policy.js && node scripts/build-music-upload-policy.js",
    "test:lt-worker": "node --test tests/lt-worker-live/*.live.mjs",
    "test:prepared": "node ../music/scripts/check-prepared.mjs && node --test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@js-temporal/polyfill": "^0.5.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "oxlint": "1.89.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "fflate": "0.7.5",
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "type": "module"
}
