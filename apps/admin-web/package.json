{
  "name": "pandd-deployment-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "schema:generate": "node scripts/generate-validators.js",
    "predev": "npm run schema:generate",
    "prebuild": "npm run schema:generate && npm run music:build",
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy:cloudflare": "vinext-cloudflare deploy",
    "start": "vinext start",
    "test": "npm run build && node --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern lib/generated && oxlint",
    "db:generate": "drizzle-kit generate",
    "music:build": "npm --prefix ../music run build:manager"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.134.0",
    "oxlint": "1.83.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "type": "module"
}
