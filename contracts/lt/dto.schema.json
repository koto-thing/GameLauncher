            "description": {
              "type": "string",
              "minLength": 1
            },
            "speakers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "affiliation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "displayName"
                ]
              }
            }
