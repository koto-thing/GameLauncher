        "id",
        "eventId",
        "version",
        "content",
        "materialUrl",
        "representativeEmail",
        "review",
        "withdrawal",
        "firstSubmittedAt",
        "everApproved",
        "slotReserved",
        "retentionExpiresAt",
        "published",
        "eventState",
        "eventCancelledAt"
