            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "affiliation": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "displayName"
            ]
          }
        }
      },
      "required": [
        "title",
        "abstract",
        "speakers"
      ]
    },
    "Application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "abstract": {
              "type": "string",
              "minLength": 1
