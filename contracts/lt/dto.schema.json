    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VALIDATION",
                "VERSION_CONFLICT",
                "DUPLICATE_APPLICATION",
                "RECRUITMENT_CLOSED",
                "CAPACITY_FULL",
                "INVALID_TRANSITION",
                "TOKEN_INVALID",
                "RATE_LIMITED",
                "RETENTION_EXPIRED",
                "SERVICE_UNAVAILABLE",
                "NOT_IMPLEMENTED"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "code"
                ]
              }
            }
          },
          "required": [
            "code",
            "requestId"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
