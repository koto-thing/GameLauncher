# Copy this file to .env.production and replace the placeholder values.
# .env.production is ignored by Git. Never commit or share the real file.

OPENSSL_EXECUTABLE=C:\Program Files\OpenSSL-Win64\bin\openssl.exe
AWS_ACCESS_KEY_ID=<production R2 Access Key ID>
AWS_SECRET_ACCESS_KEY=<production R2 Secret Access Key>
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=pandd-launcher-production
PANDD_BASE_URL=https://downloads.koto-thing.com
PANDD_PRIVATE_KEY=local-test\production-keys\manifest-private.pem
PANDD_PUBLIC_OUTPUT=local-test\production-public
