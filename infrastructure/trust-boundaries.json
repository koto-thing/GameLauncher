{
  "version": 1,
  "boundaries": {
    "platform": {
      "components": [
        "apps/store-web",
        "apps/community-web",
        "services/platform-api",
        "services/lt-api",
        "services/lt-mail"
      ],
      "data": ["platform-db", "community-db", "ugc-r2", "analytics-db"],
      "deniedCapabilities": ["intake-r2", "distribution-r2-write", "manifest-signing-key"]
    },
    "distribution": {
      "components": [
        "apps/docs",
        "apps/launcher",
        "apps/launcher-download-web",
        "apps/launcher-download-worker",
        "apps/music",
        "apps/lt-web",
        "services/distribution-content"
      ],
      "data": ["signed-manifests", "public-downloads"],
      "deniedCapabilities": ["database-write", "payment-provider-secret", "manifest-signing-key"]
    },
    "operations": {
      "components": [
        "apps/admin-web",
        "apps/docs-worker",
        "apps/intake-uploader",
        "services/deployment_publisher"
      ],
      "data": ["deployment-db", "intake-r2"],
      "deniedCapabilities": ["platform-session-secret", "platform-db-direct-access"]
    }
  }
}
